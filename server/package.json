{
  "name": "harate-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
"engines": {
  "node": ">=22.12.0"
},
  "main": "index.js",
  "scripts": {
    "dev":"tsx watch src/server.ts",
    "build":"tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck":"tsc --noEmit",
    "test": "vitest run",
    "test:watch":"vitest"
  },
  
  
  
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
